#### 2. **`lmx1b_variant_analysis.py` (Python)**
```python
import pandas as pd
import vcf  # PyVCF library for variant calling

def load_vcf(vcf_file):
    """Load and filter LMX1B variants from VCF."""
    variants = []
    for record in vcf.Reader(open(vcf_file, 'r')):
        if 'LMX1B' in record.INFO.get('GENE', ''):
            variants.append({
                'chr': record.CHROM,
                'pos': record.POS,
                'ref': record.REF,
                'alt': record.ALT[0],
                'gene': 'LMX1B'
            })
    return pd.DataFrame(variants)

if __name__ == "__main__":
    vcf_path = "data/raw/patient_organoids.vcf"
    df_variants = load_vcf(vcf_path)
    df_variants.to_csv("results/tables/lmx1b_variants.csv", index=False)
